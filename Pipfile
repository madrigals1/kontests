[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
django = ">=5.2"
djangorestframework = "*"
psycopg = { version = "*", extras = ["binary"] }
requests = "*"
beautifulsoup4 = "*"
lxml = "*"
apscheduler = "*"

[dev-packages]
black = "*"
isort = "*"
pyflakes = "*"

[requires]
python_version = "3.14"

[scripts]
lint = "bash -c 'isort . && black .'"

