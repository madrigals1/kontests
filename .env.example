# Example environment for docker-compose / local runs.
DJANGO_SECRET_KEY=dev-insecure-secret-key
DJANGO_DEBUG=1

POSTGRES_DB=kontests
POSTGRES_USER=kontests
POSTGRES_PASSWORD=kontests
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Name of the existing external Docker network that already hosts the
# PostgreSQL instance (e.g. "database_network").
DATABASE_NETWORK=database_network

# Host port to expose the app on (the container always serves on 8000).
PORT=8000

# Google API key used by the TopCoder calendar scraper. Required for TopCoder;
# leave empty to skip TopCoder gracefully. (Rotate this key in Google Cloud.)
TOPCODER_CALENDAR_KEY=
